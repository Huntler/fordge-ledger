# Copy to .env next to docker-compose.yml and edit. Only LIBRARY_PATH really
# matters; everything else has a sensible default.

# Where your project folders live on the NAS. UGOS puts shares under /volume1.
# Leave the path unquoted even with spaces in it — the value runs to the end of
# the line, and some compose implementations keep the quotes as part of it.
LIBRARY_PATH=/volume1/personal_folder/3D Druck/Custom Designs

# App cache: SQLite and thumbnails. Rebuildable, but worth keeping on disk.
DATA_PATH=./data

# Host port. Change if 8000 is taken on the NAS.
FORGE_PORT=8000

# Optional. The LAN address of the machine running Ollama or LM Studio —
# can also be set in the UI under Settings → Local LLM.
# FORGE_OLLAMA_URL=http://192.168.2.115:1234

TZ=Europe/Berlin
